# --- Docker (docker-compose.yaml) ---------------------------------------------------
# Port and address the web UI listens on (0.0.0.0 = all interfaces)
UPDATERR_PORT=5290
UPDATERR_BIND=0.0.0.0
# PREVIEW_PORT=5291          # read-only preview (docker-compose.preview.yaml)
TZ=Europe/Prague
# PUID=1000
# PGID=1000

# Media library: folder on the host and the path Radarr/Sonarr/qBittorrent see it under (must match)
MEDIA_HOST_DIR=/srv/media
MEDIA_DIR=/data/media
# Working folder for track merging and backups – inside MEDIA_DIR so hardlinks stay on the same disk
STAGING_DIR=/data/media/downloads/updaterr
# Movies and series on different filesystems? Give each app its own working folder on its library's disk
# (STAGING_DIR is then only the fallback):
# STAGING_DIR_RADARR=/data/movies/updaterr
# STAGING_DIR_SONARR=/data/tv/updaterr

# --- Radarr / Sonarr ----------------------------------------------------------------
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
# Or read the keys from a mounted config.xml (see docker-compose.override.example.yaml):
# RADARR_CONFIG=/arr/radarr.xml
# SONARR_CONFIG=/arr/sonarr.xml

# --- Languages (defaults – can also be changed in the UI → Settings → Languages) ----------
# ISO 639-1 codes: cs, sk, pl, de, fr, es, it, hu, … Without PRIMARY_LANGUAGE you pick it in the UI.
# PRIMARY_LANGUAGE=de
# SECOND_LANGUAGE=en
# UI_LANGUAGE=auto          # auto | en | cs

# --- qBittorrent – needed for merging audio tracks -----------------------------------
# QBIT_URL=http://qbittorrent:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=

# --- Notifications --------------------------------------------------------------------
# Address of the web UI for links in notifications (as you open it from your phone)
# PUBLIC_URL=http://192.168.1.10:5290
# Telegram – a bot from @BotFather; chat id e.g. via @userinfobot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ntfy – full topic URL
# NTFY_URL=https://ntfy.sh/my-secret-topic
# NTFY_TOKEN=

# --- Security -----------------------------------------------------------------------
# Optional web UI password (any username). Radarr/Sonarr webhooks don't need it.
# With a password, ntfy notifications get no "Download" buttons (the password would travel via the ntfy server).
# AUTH_PASSWORD=
# Optional webhook token – then use …/api/webhook/radarr?token=XYZ in Radarr/Sonarr
# WEBHOOK_TOKEN=
